rules_version = '2';
// Field Marshal security rules.
// Anyone can view tournaments, pits, brackets and standings.
// Only people listed in the "marshals" collection can change them.
// Players without an account can send a signup request while a tournament's signups are open.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMarshal() {
      return signedIn() && exists(/databases/$(database)/documents/marshals/$(myEmail()));
    }
    function isJudge(tid) {
      return signedIn() && exists(/databases/$(database)/documents/judges/$(tid + '__' + myEmail()));
    }
    function artsOpen(tid) {
      return exists(/databases/$(database)/documents/tournaments/$(tid))
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('kind', 'combat') == 'arts'
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('signupsOpen', true) == true
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('status', 'open') != 'final';
    }
    function validEntry(d) {
      return d.keys().hasOnly(['tid', 'name', 'park', 'orkId', 'sub', 'title', 'writeup', 'links', 'at'])
        && d.keys().hasAll(['tid', 'name', 'sub', 'title', 'writeup', 'at'])
        && d.tid is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('park' in d) || (d.park is string && d.park.size() <= 60))
        && (!('orkId' in d) || d.orkId == null || (d.orkId is string && d.orkId.size() <= 12))
        && d.sub is string && d.sub.size() <= 40
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.writeup is string && d.writeup.size() > 0 && d.writeup.size() <= 20000
        && (!('links' in d) || (d.links is list && d.links.size() <= 5))
        && d.at is number
        && artsOpen(d.tid);
    }
    function validScore(id, d) {
      return isJudge(d.tid)
        && d.keys().hasOnly(['tid', 'eid', 'judge', 'score', 'feedback', 'at'])
        && d.judge == myEmail()
        && id == d.eid + '__' + myEmail()
        && d.score is number
        && d.score >= get(/databases/$(database)/documents/tournaments/$(d.tid)).data['as']['min']
        && d.score <= get(/databases/$(database)/documents/tournaments/$(d.tid)).data['as']['max']
        && (!('feedback' in d) || (d.feedback is string && d.feedback.size() <= 5000))
        && get(/databases/$(database)/documents/tournaments/$(d.tid)).data.get('status', 'open') != 'final';
    }
    function isHeadJudge(tid) {
      return signedIn() && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('bb', {}).get('head', '') == myEmail();
    }
    function bardsOpen(tid) {
      return exists(/databases/$(database)/documents/tournaments/$(tid))
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('kind', 'combat') == 'bards'
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('signupsOpen', true) == true
        && get(/databases/$(database)/documents/tournaments/$(tid)).data.get('status', 'open') != 'final';
    }
    function validBard(d) {
      return d.keys().hasOnly(['tid', 'uid', 'name', 'park', 'orkId', 'at'])
        && d.keys().hasAll(['tid', 'uid', 'name', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('park' in d) || (d.park is string && d.park.size() <= 60))
        && (!('orkId' in d) || d.orkId == null || (d.orkId is string && d.orkId.size() <= 12))
        && d.at is number;
    }
    function bbState(tid) {
      return get(/databases/$(database)/documents/bbr/$(tid)).data;
    }
    function validRequest(d) {
      return d.keys().hasOnly(['tid', 'name', 'park', 'orkId', 'divs', 'at'])
        && d.keys().hasAll(['tid', 'name', 'divs', 'at'])
        && d.tid is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('park' in d) || (d.park is string && d.park.size() <= 60))
        && (!('orkId' in d) || d.orkId == null || (d.orkId is string && d.orkId.size() <= 12))
        && d.divs is list && d.divs.size() > 0 && d.divs.size() <= 5
        && d.divs.hasOnly(['single', 'board', 'flo', 'heavy', 'open'])
        && d.at is number
        && exists(/databases/$(database)/documents/tournaments/$(d.tid))
        && get(/databases/$(database)/documents/tournaments/$(d.tid)).data.get('signupsOpen', true) == true;
    }

    match /tournaments/{id} { allow read: if true; allow write: if isMarshal(); }
    match /fighters/{id}    { allow read: if true; allow write: if isMarshal(); }
    match /signups/{id}     { allow read: if true; allow write: if isMarshal(); }
    match /divisions/{id}   { allow read: if true; allow write: if isMarshal(); }
    match /bouts/{id}       { allow read: if true; allow write: if isMarshal(); }
    match /tallies/{id}     { allow read: if true; allow write: if isMarshal(); }
    match /ork/{id}         { allow read: if true; allow write: if isMarshal(); }
    match /results/{id}     { allow read: if true; allow write: if isMarshal(); }

    // Award recommendations stay private to marshals.
    match /recs/{id} { allow read, write: if isMarshal(); }

    // Each signed-in person may check their own marshal entry; marshals manage the list.
    match /marshals/{mail} {
      allow get: if signedIn() && myEmail() == mail;
      allow read, write: if isMarshal();
    }

    // Arts & Sciences (Dragonmaster) events.
    match /entries/{id} {
      allow read: if true;
      allow create: if validEntry(request.resource.data) || isMarshal();
      allow update, delete: if isMarshal();
    }
    // Secret key for each entrant's private feedback link. Anyone can create one with their entry; only marshals read them.
    match /entrykeys/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tid', 'key'])
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 24 && request.resource.data.key.size() <= 64
        && existsAfter(/databases/$(database)/documents/entries/$(id));
      allow read, update, delete: if isMarshal();
    }
    // Judges: doc id is {tid}__{email}. A signed-in person may check their own entry.
    match /judges/{id} {
      allow get: if signedIn() && id.split('__')[1] == myEmail();
      allow read, write: if isMarshal();
    }
    // Scores: judges write their own; judges of the event and marshals can read.
    match /scores/{id} {
      allow read: if isMarshal() || isJudge(resource.data.tid);
      allow create, update: if validScore(id, request.resource.data);
      allow delete: if isMarshal();
    }
    // Public judged averages (no individual scores).
    match /asResults/{tid} {
      allow read: if true;
      allow write: if isMarshal() || isJudge(tid);
    }
    // Published at finalize. Readable only by someone holding the unguessable link.
    match /feedback/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isMarshal();
    }

    // Battle of the Bards.
    match /bards/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.tid + '__' + request.auth.uid
        && validBard(request.resource.data)
        && bardsOpen(request.resource.data.tid);
      allow update: if isMarshal() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tid == resource.data.tid
        && validBard(request.resource.data));
      allow delete: if isMarshal() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    // Each bard's Google Drive link for a round, only while that round is open for entries.
    match /bsubs/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['tid', 'uid', 'bid', 'round', 'url', 'note', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bid == request.resource.data.tid + '__' + request.auth.uid
        && id == request.resource.data.bid + '__r' + string(request.resource.data.round)
        && exists(/databases/$(database)/documents/bards/$(request.resource.data.bid))
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('https://.+')
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 200))
        && bbState(request.resource.data.tid).get('phase', '') == 'entries'
        && bbState(request.resource.data.tid).get('round', -1) == request.resource.data.round;
      allow delete: if isMarshal();
    }
    // Judges' ballots: each judge writes their own, only while the round is open for voting.
    match /bvotes/{id} {
      allow read: if isMarshal() || isJudge(resource.data.tid);
      allow create, update: if isJudge(request.resource.data.tid)
        && request.resource.data.keys().hasOnly(['tid', 'm', 'round', 'judge', 'pick', 'dragon', 'at'])
        && request.resource.data.judge == myEmail()
        && id == request.resource.data.tid + '__' + request.resource.data.m + '__' + myEmail()
        && request.resource.data.dragon is list && request.resource.data.dragon.size() <= 2
        && bbState(request.resource.data.tid).get('phase', '') == 'voting'
        && bbState(request.resource.data.tid).get('round', -1) == request.resource.data.round;
      allow delete: if isMarshal();
    }
    // Public bracket state. Organizers run it; the head judge can break ties.
    match /bbr/{tid} {
      allow read: if true;
      allow write: if isMarshal() || isHeadJudge(tid);
    }

    // Player signup requests.
    match /requests/{id} {
      allow create: if validRequest(request.resource.data);
      allow read, update, delete: if isMarshal();
    }
  }
}
